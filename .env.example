# ══════════════════════════════════════════════════════════════════
#  Arena — конфигурация.
#  1. Скопируйте этот файл:   cp .env.example .env
#  2. Заполните LLM_API_KEY (и, при необходимости, BASE_URL/MODEL).
#  .env добавлен в .gitignore — ваши ключи не попадут в репозиторий.
# ══════════════════════════════════════════════════════════════════

# ── Провайдер LLM ─────────────────────────────────────────────────
# Любой OpenAI-совместимый API: OpenAI, DeepSeek, OpenRouter, Groq,
# Together, vLLM, локальная Ollama и т.д.
# Для keyless-эндпоинтов (например, Ollama) ключ можно оставить пустым.
LLM_API_KEY=

# Базовый URL API (полный путь до /v1, без слэша на конце). Примеры:
#   OpenAI      https://api.openai.com/v1
#   DeepSeek    https://api.deepseek.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://host.docker.internal:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# ID модели, например: gpt-4o-mini, deepseek-chat, llama3.1:8b
LLM_MODEL=gpt-4o-mini

# Таймаут одного вызова модели (секунды). По истечении — ответ помечается error.
LLM_TIMEOUT_S=120

# Повторы при HTTP 429 (экспоненциальный backoff).
LLM_MAX_RETRIES=3

# ── Арена ─────────────────────────────────────────────────────────
# Сколько инстансов модели бегут параллельно на один промпт.
ARENA_N=10

# Максимум одновременных запросов к провайдеру; остальные ждут в очереди.
MAX_CONCURRENCY=5

# Сколько судей голосуют: 1 — один судья, 3 — жюри с majority vote.
JUDGES=1

# Критерии оценки судьи (через запятую).
JUDGE_CRITERIA=корректность,полнота,читаемость

# Верификация ответов-кода: команда с плейсхолдером {file}. Пусто = выключено.
# Если задана — ответы прогоняются через неё автоматически (в API можно
# отключить флагом verify: false). Не прошедшие помечаются disqualified.
#   Python: python -m py_compile {file}
#   Node:   node --check {file}
VERIFY_CMD=

# Таймаут одной команды верификации (секунды).
VERIFY_TIMEOUT_S=60

# ── Сервер и хранилище ────────────────────────────────────────────
# Порт, на котором откроется UI: http://localhost:<PORT>
PORT=3000

# Файл SQLite. Путь относительный (от корня проекта); папка создаётся сама.
DB_PATH=./data/arena.db

# Разрешённые CORS-origins (через запятую). "*" — для локальной разработки.
CORS_ORIGINS=*

# ── Фронтенд ──────────────────────────────────────────────────────
# Адрес API для браузера. Пусто = относительный /api — работает в Docker
# (через nginx) и в локальной разработке (через vite-прокси). Менять не нужно.
VITE_API_URL=

# Только для локальной разработки без Docker: куда vite-прокси шлёт /api.
DEV_API_PROXY=http://127.0.0.1:8000
